generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DashboardRole {
  ADMIN
  MANAGER
  COUNSELOR
  ANALYST
  VIEWER
}

enum ConversationStatus {
  OPEN
  WAITING
  RESOLVED
  CLOSED
  SPAM
}

enum AgentMode {
  AI
  HUMAN
  REVIEW_REQUIRED
  PAUSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageActor {
  CUSTOMER
  AI
  COUNSELOR
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LOCATION
  INTERACTIVE
  TEMPLATE
  REACTION
  UNSUPPORTED
}

enum MessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum LeadTemperature {
  HOT
  WARM
  COLD
  UNQUALIFIED
}

enum LeadStage {
  NEW
  DISCOVERY
  QUALIFIED
  COUNSELOR_ASSIGNED
  DEMO_BOOKED
  PAYMENT_PENDING
  ENROLLED
  NURTURE
  CLOSED
}

enum ConsentStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

enum KnowledgeStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum LearningStatus {
  PENDING
  APPROVED
  REJECTED
  MERGED
}

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

model DashboardUser {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         DashboardRole @default(COUNSELOR)
  isActive     Boolean       @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  sessions              DashboardSession[]
  assignedConversations WhatsAppConversation[] @relation("ConversationAssignee")
  assignedLeads         Lead[]                 @relation("LeadAssignee")
  sentMessages          WhatsAppMessage[]      @relation("MessageSender")
  leadNotes             LeadNote[]
  reviewedLearning      LearningSuggestion[]   @relation("LearningReviewer")
  auditLogs             AuditLog[]             @relation("AuditActor")
  workspaceMemberships  EngageWorkspaceMembership[] @relation("EngageMembershipUser")

  @@index([role, isActive])
}

model DashboardSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user DashboardUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String?
  succeeded Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

model WhatsAppContact {
  id                   String        @id @default(cuid())
  waId                 String        @unique
  phone                String        @unique
  displayName          String?
  profileName          String?
  email                String?
  city                 String?
  language             String?
  consentStatus        ConsentStatus @default(UNKNOWN)
  marketingOptInAt     DateTime?
  marketingOptInSource String?
  optedOutAt           DateTime?
  metadata             Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  conversations WhatsAppConversation[]
  lead          Lead?

  @@index([displayName])
  @@index([consentStatus])
}

model WhatsAppConversation {
  id                     String             @id @default(cuid())
  contactId              String
  assignedToId           String?
  status                 ConversationStatus @default(OPEN)
  agentMode              AgentMode          @default(AI)
  source                 String?
  campaign               String?
  currentIntent          String?
  detectedLanguage       String?
  aiConfidence           Float?
  aiSummary              String?
  unreadCount            Int                @default(0)
  lastMessageAt          DateTime?
  serviceWindowExpiresAt DateTime?
  humanTakeoverAt        DateTime?
  humanTakeoverReason    String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  contact    WhatsAppContact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedTo DashboardUser?       @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   WhatsAppMessage[]
  lead       Lead?
  tags       ConversationTagLink[]

  @@index([status, lastMessageAt])
  @@index([assignedToId, status])
  @@index([contactId, createdAt])
  @@index([agentMode])
}

model WhatsAppMessage {
  id                   String           @id @default(cuid())
  conversationId       String
  sentById             String?
  metaMessageId        String?          @unique
  direction            MessageDirection
  actor                 MessageActor
  type                  MessageType      @default(TEXT)
  status                MessageStatus
  text                  String?
  mediaId               String?
  mediaUrl              String?
  mimeType              String?
  filename              String?
  replyToMetaMessageId  String?
  aiConfidence          Float?
  aiModel               String?
  knowledgeReferences   Json?
  failureCode           String?
  failureReason         String?
  rawPayload            Json?
  messageTimestamp      DateTime
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  conversation        WhatsAppConversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sentBy              DashboardUser?              @relation("MessageSender", fields: [sentById], references: [id], onDelete: SetNull)
  statusEvents        WhatsAppMessageStatusEvent[]
  learningSuggestions LearningSuggestion[]

  @@index([conversationId, messageTimestamp])
  @@index([status, createdAt])
  @@index([direction, actor])
}

model WhatsAppMessageStatusEvent {
  id            String        @id @default(cuid())
  messageId     String
  status        MessageStatus
  metaTimestamp DateTime?
  rawPayload    Json?
  createdAt     DateTime      @default(now())

  message WhatsAppMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
}

model Lead {
  id                  String          @id @default(cuid())
  contactId           String          @unique
  conversationId      String          @unique
  assignedToId        String?
  stage               LeadStage       @default(NEW)
  temperature         LeadTemperature @default(COLD)
  score               Int             @default(0)
  occupation          String?
  experienceLevel     String?
  goal                String?
  interestedCourse    String?
  joiningTimeline     String?
  classAvailability   String?
  feeUnderstood       Boolean         @default(false)
  counselorRequested  Boolean         @default(false)
  nextFollowUpAt      DateTime?
  qualifiedAt         DateTime?
  closedAt             DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  contact      WhatsAppContact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assignedTo   DashboardUser?       @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes        LeadNote[]

  @@index([stage, temperature])
  @@index([assignedToId, nextFollowUpAt])
  @@index([score])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead   Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author DashboardUser @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
}

model ConversationTag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())

  conversations ConversationTagLink[]
}

model ConversationTagLink {
  conversationId String
  tagId          String
  createdAt      DateTime @default(now())

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          ConversationTag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@index([tagId])
}

model KnowledgeDocument {
  id            String          @id @default(cuid())
  title         String
  category      String
  sourceType    String
  sourceUrl     String?
  version       Int             @default(1)
  status        KnowledgeStatus @default(DRAFT)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  approvedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  chunks KnowledgeChunk[]

  @@index([status, category])
  @@index([effectiveFrom, effectiveTo])
}

model KnowledgeChunk {
  id          String   @id @default(cuid())
  documentId  String
  heading     String?
  content     String
  checksum    String
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, checksum])
  @@index([documentId])
}

model LearningSuggestion {
  id               String         @id @default(cuid())
  sourceMessageId  String?
  reviewedById     String?
  status           LearningStatus @default(PENDING)
  category         String
  userQuestion     String
  originalAnswer   String?
  proposedAnswer   String
  correctionReason String?
  redactedPayload  Json?
  reviewedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  sourceMessage WhatsAppMessage? @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  reviewedBy    DashboardUser?   @relation("LearningReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([category])
}

model WhatsAppTemplate {
  id               String         @id @default(cuid())
  metaTemplateId   String?        @unique
  name             String         @unique
  language         String
  category         String
  status           TemplateStatus @default(DRAFT)
  components       Json
  lastSyncedAt     DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status, category])
}

model WebhookEvent {
  id              String   @id @default(cuid())
  eventKey        String   @unique
  eventType       String
  payload         Json
  processedAt     DateTime?
  processingError String?
  attemptCount    Int      @default(0)
  receivedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([processedAt, receivedAt])
  @@index([eventType])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor DashboardUser? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model EngageWorkspace {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  timezone  String   @default("Asia/Kolkata")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships              EngageWorkspaceMembership[]
  connections              EngageChannelConnection[]
  consentEvents            EngageCustomerConsentEvent[]
  suppressions             EngageCustomerSuppression[]
  killSwitches             EngageKillSwitch[]
  replayRecords            EngageWebhookReplayRecord[]
  auditEvents              EngageSecurityAuditEvent[]
  featureFlags             EngageFeatureFlag[]
  agencyClientLinks        EngageAgencyWorkspaceLink[] @relation("EngageAgencyClientWorkspace")
  agencyParentLinks        EngageAgencyWorkspaceLink[] @relation("EngageAgencyParentWorkspace")
  saasState                EngageWorkspaceSaasState?
  publicApiKeys            EngagePublicApiKey[]
  usageEvents              EngageWorkspaceUsageEvent[]
  whiteLabelConfig         EngageWhiteLabelConfig?
  customDomains            EngageCustomDomain[]
  developerRequestLogs     EngageDeveloperRequestLog[]
  outboundWebhookEndpoints EngageOutboundWebhookEndpoint[]
  controlledLaunchState    EngageControlledLaunchState?
  controlledLaunchHistory  EngageControlledLaunchTransition[]
  emailTemplates            EngageEmailTemplate[]
  emailTemplateVersions     EngageEmailTemplateVersion[]
  emailTemplateAssets       EngageEmailTemplateAsset[]


  emailMessages             EngageEmailMessage[]
  emailAutomationEvents     EngageEmailAutomationEvent[]
  emailInboundMessages      EngageEmailInboundMessage[]
  emailCampaigns            EngageEmailCampaign[]
  emailCampaignRecipients   EngageEmailCampaignRecipient[]
  emailSequences            EngageEmailSequence[]
  emailSequenceEnrollments  EngageEmailSequenceEnrollment[]
  emailAnalyticsEvents      EngageEmailAnalyticsEvent[]
  emailAutomationTasks      EngageEmailAutomationTask[]
@@index([isActive, createdAt])
}

model EngageWorkspaceMembership {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   EngageWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        DashboardUser   @relation("EngageMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  permissions EngagePermissionGrant[]

  @@unique([workspaceId, userId])
  @@index([userId, isActive])
  @@index([workspaceId, role, isActive])
}

model EngagePermissionGrant {
  id           String   @id @default(cuid())
  membershipId String
  permission   String
  createdAt    DateTime @default(now())

  membership EngageWorkspaceMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, permission])
  @@index([permission])
}

model EngageChannelConnection {
  id                String   @id @default(cuid())
  workspaceId       String
  channel           String
  externalAccountId String
  displayName       String?
  status            String   @default("PENDING")
  capabilities      Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace     EngageWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  credentials   EngageConnectionCredential[]
  consentEvents EngageCustomerConsentEvent[]
  suppressions  EngageCustomerSuppression[]
  killSwitches  EngageKillSwitch[]
  replayRecords EngageWebhookReplayRecord[]

  @@unique([workspaceId, channel, externalAccountId])
  @@index([workspaceId, channel, status])
}

model EngageConnectionCredential {
  id                   String   @id @default(cuid())
  workspaceId          String
  connectionId         String
  kind                 String
  algorithm            String   @default("AES_256_GCM")
  keyVersion           String
  initializationVector String
  authenticationTag    String
  ciphertext           String
  expiresAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  connection EngageChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, kind])
  @@index([workspaceId, expiresAt])
}

model EngageCustomerConsentEvent {
  id           String   @id @default(cuid())
  workspaceId  String
  customerRef  String
  connectionId String?
  channel      String
  purpose      String
  state        String
  source       String
  evidence     Json?
  occurredAt   DateTime
  recordedAt   DateTime @default(now())

  workspace  EngageWorkspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection EngageChannelConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, customerRef, channel, purpose, occurredAt])
  @@index([connectionId, occurredAt])
}

model EngageCustomerSuppression {
  id           String   @id @default(cuid())
  workspaceId  String
  customerRef  String?
  connectionId String?
  channel      String?
  purposes     Json
  reason       String
  startsAt     DateTime @default(now())
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace  EngageWorkspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection EngageChannelConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, customerRef, startsAt])
  @@index([workspaceId, channel, startsAt])
  @@index([connectionId, startsAt])
}

model EngageKillSwitch {
  id             String   @id @default(cuid())
  workspaceId    String
  connectionId   String?
  scopeType      String
  channel        String?
  automationId   String?
  campaignId     String?
  blockedActions Json
  reason         String
  active         Boolean  @default(true)
  activatedById  String?
  activatedAt    DateTime @default(now())
  deactivatedAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  EngageWorkspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection EngageChannelConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, active, scopeType])
  @@index([connectionId, active])
  @@index([channel, active])
}

model EngageWebhookReplayRecord {
  id              String   @id @default(cuid())
  workspaceId     String
  connectionId    String
  replayKey       String   @unique
  signatureDigest String
  receivedAt      DateTime @default(now())
  expiresAt       DateTime

  workspace  EngageWorkspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection EngageChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, expiresAt])
  @@index([connectionId, receivedAt])
}

model EngageSecurityAuditEvent {
  id            String   @id @default(cuid())
  workspaceId   String
  actorId       String?
  action        String
  outcome       String
  entityType    String
  entityId      String?
  reasonCode    String?
  requestId     String?
  correlationId String?
  metadata      Json?
  occurredAt    DateTime
  createdAt     DateTime @default(now())

  workspace EngageWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, occurredAt])
  @@index([workspaceId, action, outcome, occurredAt])
  @@index([actorId, occurredAt])
  @@index([entityType, entityId, occurredAt])
}

model EngageFeatureFlag {
  id          String   @id @default(cuid())
  workspaceId String
  key         String
  enabled     Boolean  @default(false)
  config      Json?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace EngageWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([key, enabled])
}

model EngageAgencyWorkspaceLink {
  id                String   @id @default(cuid())
  workspaceId       String
  agencyWorkspaceId String
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  clientWorkspace EngageWorkspace @relation("EngageAgencyClientWorkspace", fields: [workspaceId], references: [id], onDelete: Cascade)
  agencyWorkspace EngageWorkspace @relation("EngageAgencyParentWorkspace", fields: [agencyWorkspaceId], references: [id], onDelete: Cascade)

  @@unique([agencyWorkspaceId, workspaceId])
  @@index([workspaceId, status])
  @@index([agencyWorkspaceId, status])
}

model EngageWorkspaceSaasState {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  planKey     String   @default("internal")
  status      String   @default("INTERNAL")
  effectiveAt DateTime @default(now())
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace EngageWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([planKey, status])
}

model EngagePublicApiKey {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  prefix      String
  sha256      String   @unique
  scopes      Json
  revokedAt   DateTime?
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   EngageWorkspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestLogs EngageDeveloperRequestLog[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, prefix])
  @@index([workspaceId, revokedAt, expiresAt])
}

model EngageWorkspaceUsageEvent {
  id             String   @id @default(cuid())
  workspaceId    String
  idempotencyKey String
  metric         String
  quantity       Int      @default(1)
  occurredAt     DateTime
  metadata       Json?
  createdAt      DateTime @default(now())

  workspace EngageWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, metric, occurredAt])
}

model EngageWhiteLabelConfig {
  id           String   @id @default(cuid())
  workspaceId  String   @unique
  enabled      Boolean  @default(false)
  brandName    String?
  logoUrl      String?
  faviconUrl   String?
  primaryColor String?
  supportEmail String?
  branding     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace EngageWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model EngageCustomDomain {
  id                 String   @id @default(cuid())
  workspaceId        String
  hostname           String   @unique
  status             String   @default("PENDING")
  verificationDigest String?
  verifiedAt         DateTime?
  lastCheckedAt      DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace EngageWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

model EngageDeveloperRequestLog {
  id                String   @id @default(cuid())
  workspaceId       String
  apiKeyWorkspaceId String?
  apiKeyId          String?
  requestId         String
  method            String
  path              String
  statusCode        Int?
  durationMs        Int?
  rateLimitDecision String?
  ipHash            String?
  userAgentHash     String?
  metadata          Json?
  occurredAt        DateTime
  createdAt         DateTime @default(now())

  workspace EngageWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  apiKey    EngagePublicApiKey? @relation(fields: [apiKeyWorkspaceId, apiKeyId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, requestId])
  @@index([workspaceId, occurredAt])
  @@index([apiKeyWorkspaceId, apiKeyId, occurredAt])
}

model EngageOutboundWebhookEndpoint {
  id                   String   @id @default(cuid())
  workspaceId          String
  name                 String
  url                  String
  events               Json
  status               String   @default("ACTIVE")
  algorithm            String   @default("AES_256_GCM")
  keyVersion           String
  initializationVector String
  authenticationTag    String
  ciphertext           String
  pausedAt             DateTime?
  revokedAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace EngageWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
  @@index([workspaceId, status, createdAt])
}

model EngageControlledLaunchState {
  id                    String   @id @default(cuid())
  workspaceId           String   @unique
  stage                 String
  mode                  String
  writePolicy           String
  externalWritesAllowed Boolean  @default(false)
  scope                 Json
  version               Int      @default(1)
  activatedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace   EngageWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transitions EngageControlledLaunchTransition[]

  @@index([stage, mode])
}

model EngageControlledLaunchTransition {
  id                        String   @id @default(cuid())
  workspaceId               String
  stateId                   String
  fromStage                 String?
  toStage                   String
  fromMode                  String?
  toMode                    String
  fromWritePolicy           String?
  toWritePolicy             String
  fromExternalWritesAllowed Boolean?
  toExternalWritesAllowed   Boolean
  expectedVersion           Int?
  resultingVersion          Int
  actorUserId               String?
  reason                    String
  scope                     Json
  createdAt                 DateTime @default(now())

  workspace EngageWorkspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  state     EngageControlledLaunchState @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([stateId, resultingVersion])
  @@index([workspaceId, createdAt])
}

model EngageEmailTemplate {
  id                      String   @id @default(cuid())
  workspaceId             String
  name                    String
  category                String
  status                  String   @default("DRAFT")
  currentVersion          Int      @default(1)
  defaultSenderIdentityId String?
  createdById             String
  approvedById            String?
  approvedAt              DateTime?
  archivedAt              DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  workspace EngageWorkspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions  EngageEmailTemplateVersion[]
  assets    EngageEmailTemplateAsset[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status, category, updatedAt])
}

model EngageEmailTemplateVersion {
  id                      String   @id @default(cuid())
  workspaceId             String
  templateId              String
  version                 Int
  subject                 String
  preheader               String?
  document                Json
  variables               Json
  defaultSenderIdentityId String?
  createdById             String
  approvedById            String?
  approvedAt              DateTime?
  createdAt               DateTime @default(now())

  workspace EngageWorkspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template  EngageEmailTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  assets    EngageEmailTemplateAsset[]

  @@unique([templateId, version])
  @@index([workspaceId, templateId, createdAt])
}

