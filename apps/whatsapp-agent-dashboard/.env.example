# Database used only by the WhatsApp AI Agent dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sikhadenge_whatsapp_agent?schema=public"

# Initial admin is created through `npm run db:seed`.
DASHBOARD_ADMIN_NAME="Ankit Singh"
DASHBOARD_ADMIN_EMAIL="admin@sikhadenge.in"
DASHBOARD_ADMIN_PASSWORD="CHANGE_THIS_BEFORE_SEEDING"

# Session configuration.
DASHBOARD_SESSION_DAYS="7"
SESSION_SECRET="GENERATE_A_LONG_RANDOM_SECRET"
APP_URL="https://whatsapp.sikhadenge.in"

# Meta WhatsApp Cloud API credentials. Keep these only in the server environment.
WHATSAPP_VERIFY_TOKEN="GENERATE_A_PRIVATE_RANDOM_VERIFY_TOKEN"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_GRAPH_VERSION="v23.0"
WHATSAPP_WEBHOOK_MAX_BYTES="2000000"
WHATSAPP_OUTBOUND_TIMEOUT_MS="20000"
WHATSAPP_TYPING_TIMEOUT_MS="10000"

# Live outbound delivery requires all four values below.
WHATSAPP_OUTBOUND_MODE="disabled"
WHATSAPP_CUTOVER_APPROVED="false"
WHATSAPP_OUTBOUND_LIVE_ACK=""
WHATSAPP_OUTBOUND_KILL_SWITCH="off"

# SikhaDenge-owned reply engine. No external AI key is required in owned mode.
AGENT_REPLY_ENGINE_MODE="owned"
AGENT_TIMEZONE="Asia/Kolkata"
AGENT_TYPING_INDICATOR_ENABLED="true"
AGENT_TYPING_DELAY_MS="2000"
SIKHADENGE_MASTERCLASS_URL=""

# Agent runtime. Keep automatic replies disabled until manual sending passes.
AGENT_ENABLED="true"
AGENT_MODEL_CALLS_ENABLED="false"
AGENT_WEBHOOK_ANALYSIS_ENABLED="true"
AGENT_AUTO_REPLY_ENABLED="false"
AGENT_IMMEDIATE_DISPATCH_ENABLED="false"
AGENT_KILL_SWITCH="false"

# Bulk/external actions remain independently controlled.
WHATSAPP_CAMPAIGNS_ENABLED="false"
AUTOMATION_ACTIONS_ENABLED="false"
INTEGRATION_EXTERNAL_WRITES_ENABLED="false"

# Optional external-model configuration. Not used while AGENT_REPLY_ENGINE_MODE="owned".
AI_PROVIDER=""
AI_API_KEY=""
AI_MODEL=""
OPENAI_API_KEY=""
OPENAI_MODEL=""
