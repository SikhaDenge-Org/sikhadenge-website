# Database used only by the WhatsApp AI Agent dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sikhadenge_whatsapp_agent?schema=public"

# Durable EngageOS event runtime. Keep both flags false until Redis and the standalone worker are verified.
REDIS_URL=""
ENGAGEOS_EVENT_RUNTIME_ENABLED="false"
ENGAGEOS_EVENT_WORKER_ENABLED="false"

# Phase 6 WhatsApp core migration. Legacy is the rollback-safe default.
ENGAGEOS_WHATSAPP_CORE_MODE="legacy"
# Set true only after an explicitly approved production backfill has been executed and parity captured.
ENGAGEOS_WHATSAPP_BACKFILL_COMPLETE="false"

# Initial admin is created through `npm run db:seed`.
DASHBOARD_ADMIN_NAME="Ankit Singh"
DASHBOARD_ADMIN_EMAIL="admin@sikhadenge.in"
DASHBOARD_ADMIN_PASSWORD="CHANGE_THIS_BEFORE_SEEDING"

# Session configuration.
DASHBOARD_SESSION_DAYS="7"
SESSION_SECRET="GENERATE_A_LONG_RANDOM_SECRET"
APP_URL="https://whatsapp.sikhadenge.in"

# Optional server-to-server read-only analytics bearer tokens. Keep real values only in production secrets.
WHATSAPP_ANALYTICS_TOKEN=""
WHATSAPP_AGENT_ANALYTICS_TOKEN=""

# Meta WhatsApp Cloud API credentials. Keep these only in the server environment.
WHATSAPP_VERIFY_TOKEN="GENERATE_A_PRIVATE_RANDOM_VERIFY_TOKEN"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_APP_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_GRAPH_VERSION="v23.0"
WHATSAPP_WEBHOOK_MAX_BYTES="2000000"
WHATSAPP_OUTBOUND_TIMEOUT_MS="20000"
WHATSAPP_TYPING_TIMEOUT_MS="10000"

# Transitional mirror into the canonical SikhaDenge dashboard webhook ingest.
# Keep OFF until the canonical receiver is deployed and verified. The mirror
# forwards the exact Meta-signed raw body and original x-hub-signature-256;
# the canonical receiver independently verifies the Meta signature.
WHATSAPP_CANONICAL_MIRROR_ENABLED="false"
WHATSAPP_CANONICAL_MIRROR_URL=""

# Instagram API with Instagram Login. Never commit real secrets or tokens.
INSTAGRAM_VERIFY_TOKEN="GENERATE_A_PRIVATE_RANDOM_VERIFY_TOKEN"
INSTAGRAM_APP_SECRET=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_ACCOUNT_ID=""
INSTAGRAM_GRAPH_VERSION="v23.0"
INSTAGRAM_WEBHOOK_MAX_BYTES="2000000"
INSTAGRAM_OUTBOUND_MODE="disabled"
INSTAGRAM_OUTBOUND_KILL_SWITCH="off"
INSTAGRAM_OUTBOUND_TIMEOUT_MS="20000"

# Phase 7 Instagram comment automation. All external actions fail closed by default.
INSTAGRAM_COMMENT_AUTOMATION_ENABLED="false"
INSTAGRAM_COMMENT_ACTION_MODE="disabled"
INSTAGRAM_COMMENT_ACTION_KILL_SWITCH="on"
INSTAGRAM_COMMENT_RULES_JSON="[]"
INSTAGRAM_COMMENT_PRIVATE_REPLY_WINDOW_MS="604800000"

# Facebook Messenger Platform webhook. The app secret is the Meta app secret.
MESSENGER_VERIFY_TOKEN="GENERATE_A_PRIVATE_RANDOM_VERIFY_TOKEN"
MESSENGER_APP_SECRET=""
MESSENGER_PAGE_ACCESS_TOKEN=""
MESSENGER_PAGE_ID=""
MESSENGER_GRAPH_VERSION="v23.0"
MESSENGER_WEBHOOK_MAX_BYTES="2000000"
MESSENGER_OUTBOUND_MODE="disabled"
MESSENGER_OUTBOUND_KILL_SWITCH="off"
MESSENGER_OUTBOUND_TIMEOUT_MS="20000"

# Phase 8 Facebook Page comment automation. All external actions fail closed by default.
FACEBOOK_PAGE_COMMENT_AUTOMATION_ENABLED="false"
FACEBOOK_PAGE_COMMENT_ACTION_MODE="disabled"
FACEBOOK_PAGE_COMMENT_ACTION_KILL_SWITCH="on"
FACEBOOK_PAGE_COMMENT_WRITE_APPROVED="false"
FACEBOOK_PAGE_COMMENT_RULES_JSON="[]"
# Enforces Page isolation, verified Messenger capability and the standard response window when enabled.
ENGAGEOS_MESSENGER_POLICY_ENFORCED="false"

# Live WhatsApp outbound delivery requires all four values below.
WHATSAPP_OUTBOUND_MODE="disabled"
WHATSAPP_CUTOVER_APPROVED="false"
WHATSAPP_OUTBOUND_LIVE_ACK=""
WHATSAPP_OUTBOUND_KILL_SWITCH="off"

# SikhaDenge-owned reply engine. No external AI key is required in owned mode.
AGENT_REPLY_ENGINE_MODE="owned"
AGENT_TIMEZONE="Asia/Kolkata"
AGENT_TYPING_INDICATOR_ENABLED="true"
AGENT_TYPING_DELAY_MS="2000"
SIKHADENGE_MASTERCLASS_URL=""

# Become AI Expert masterclass community conversion flow.
# The persisted dashboard configuration becomes the runtime source of truth.
MASTERCLASS_COMMUNITY_FLOW_ENABLED="true"
MASTERCLASS_NAME="Free AI Expert Masterclass"
MASTERCLASS_DATE_LABEL="Friday, 07 August"
MASTERCLASS_TIME_LABEL="08:00 PM"
MASTERCLASS_COMMUNITY_URL="https://chat.whatsapp.com/DWeqmllf2x064XjeOP4yRd"

# Secured external registration source -> dashboard webhook.
# Generate at least 32 random bytes and keep the same secret only on both servers.
MASTERCLASS_REGISTRATION_WEBHOOK_SECRET="GENERATE_A_LONG_RANDOM_WEBHOOK_SECRET"

# Agent runtime. Keep automatic replies disabled until manual sending passes.
AGENT_ENABLED="true"
AGENT_MODEL_CALLS_ENABLED="false"
AGENT_WEBHOOK_ANALYSIS_ENABLED="true"
AGENT_AUTO_REPLY_ENABLED="false"
AGENT_IMMEDIATE_DISPATCH_ENABLED="false"
AGENT_KILL_SWITCH="false"

# Bulk/external actions remain independently controlled.
# Masterclass registration writes, template submission, due dispatch and worker cycles
# remain paused unless AUTOMATION_ACTIONS_ENABLED is explicitly true.
WHATSAPP_CAMPAIGNS_ENABLED="false"
AUTOMATION_ACTIONS_ENABLED="false"
INTEGRATION_EXTERNAL_WRITES_ENABLED="false"

# Optional external-model configuration. Not used while AGENT_REPLY_ENGINE_MODE="owned".
AI_PROVIDER=""
AI_API_KEY=""
AI_MODEL=""
OPENAI_API_KEY=""
OPENAI_MODEL=""

# Email Automation Engine — E1 Gmail / Google Workspace.
# Create a Web application OAuth client in Google Cloud and register the exact callback URL.
GOOGLE_GMAIL_CLIENT_ID=""
GOOGLE_GMAIL_CLIENT_SECRET=""
# Random server-only secret, minimum 32 characters, used to sign OAuth state.
GOOGLE_GMAIL_OAUTH_STATE_SECRET=""
# Base64 for exactly 32 random bytes. Never expose this value to the browser.
EMAIL_CREDENTIAL_ENCRYPTION_KEY_B64=""
EMAIL_CREDENTIAL_KEY_VERSION="email-v1"
# Dedicated storage root for email template inline images and attachments.
EMAIL_TEMPLATE_ASSET_STORAGE_DIR="/var/www/sikhadenge-whatsapp-agent/storage/email-template-assets"

# Email runtime is fail-closed by default. E1 must remain disabled for external delivery.
EMAIL_RUNTIME_ENABLED="false"
EMAIL_RUNTIME_MODE="DISABLED"
EMAIL_EXTERNAL_WRITES_ENABLED="false"
# Comma-separated addresses allowed while EMAIL_RUNTIME_MODE=INTERNAL_RECIPIENTS.
EMAIL_INTERNAL_RECIPIENT_ALLOWLIST=""
EMAIL_AUTOMATION_ENABLED="false"
# Server-only Bearer token for the internal automation scheduler endpoint. Leave empty to disable scheduler invocation.
EMAIL_AUTOMATION_SCHEDULER_TOKEN=""
# Local/internal app base URL used by the scheduler caller script.
EMAIL_AUTOMATION_SCHEDULER_BASE_URL="http://127.0.0.1:3100"
EMAIL_INBOUND_SYNC_ENABLED="false"
EMAIL_TRACKING_ENABLED="false"
# Phase D scaled-delivery evidence. Leave unset/empty until authoritative checks qualify the active sending domain/provider.
# LIMITED_COHORT and LIVE fail closed unless all three alignment values are true and both current rates are valid and below ceilings.
EMAIL_DELIVERABILITY_SPF_ALIGNED=""
EMAIL_DELIVERABILITY_DKIM_ALIGNED=""
EMAIL_DELIVERABILITY_DMARC_ALIGNED=""
EMAIL_DELIVERABILITY_HARD_BOUNCE_RATE_PCT=""
EMAIL_DELIVERABILITY_COMPLAINT_RATE_PCT=""
# Gmail inbound push notifications. Example: projects/PROJECT_ID/topics/gmail-inbound
GOOGLE_GMAIL_PUBSUB_TOPIC=""
# Microsoft 365 / Graph OAuth. All values are server-only.
MICROSOFT_EMAIL_CLIENT_ID=""
MICROSOFT_EMAIL_CLIENT_SECRET=""
MICROSOFT_EMAIL_TENANT_ID=""
MICROSOFT_EMAIL_OAUTH_STATE_SECRET=""
# HMAC secrets for open/click tracking and one-click marketing unsubscribe (minimum 32 chars when enabled/used).
EMAIL_TRACKING_SECRET=""
EMAIL_UNSUBSCRIBE_SECRET=""
# Provider failover is disabled by default. No silent cross-provider retry occurs unless explicitly enabled.
EMAIL_PROVIDER_FAILOVER_ENABLED="false"
EMAIL_PROVIDER_FAILOVER_ORDER="GOOGLE_GMAIL,MICROSOFT_365"

# WhatsApp automation scheduler. Scheduler may run while all execution flags remain false.
WHATSAPP_AUTOMATION_SCHEDULER_ENABLED="false"
WHATSAPP_AUTOMATION_SCHEDULER_INTERVAL_MS="5000"
WHATSAPP_AUTOMATION_SYSTEM_ACTOR_ID=""
WHATSAPP_AUTOMATION_OUTBOUND_DISPATCH_ENABLED="false"
# Extra acknowledgement required before any non-targeted scheduler cycle may sweep the global QUEUED pool.
WHATSAPP_AUTOMATION_ALLOW_GLOBAL_QUEUED_DISPATCH="false"
AUTOMATION_RUNTIME_ENABLED="false"
AUTOMATION_ACTIONS_ENABLED="false"
JOURNEY_RUNTIME_ENABLED="false"
JOURNEY_ACTIONS_ENABLED="false"
